{
  "name": "phishing-kit-test",
  "version": "1.0.0",
  "description": "Security research & educational phishing simulation",
  "main": "index.html",
  "scripts": {
    "start": "php -S localhost:8000",
    "dev": "nodemon --watch . --ext php,html,js,json --exec 'php -S localhost:8000'",
    "build": "echo 'No build step required'",
    "test": "echo 'Error: no test specified' && exit 1",
    "lint": "eslint . --ext .js",
    "format": "prettier --write '**/*.{js,html,css,json}'",
    "security-check": "npm audit && npm run lint",
    "docker:build": "docker build -t phishing-kit-test .",
    "docker:run": "docker run -p 8000:80 phishing-kit-test",
    "clean": "rm -rf logs/ uploads/ locations/ *.log *.txt",
    "setup": "mkdir -p logs uploads locations && chmod 755 logs uploads locations"
  },
  "keywords": [
    "security-testing",
    "educational",
    "phishing-simulation",
    "red-team",
    "web-security"
  ],
  "author": "Testing",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.1.1"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1"
  }
}
